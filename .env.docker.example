# -----------------------------------------------------------------------------
# Local Docker stack environment
# -----------------------------------------------------------------------------

# Ports
FRONTEND_PORT=8080
MIDDLEWARE_PORT=8000
ML_SERVICE_PORT=7860
LOCAL_POSTGRES_PORT=5432
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025

# Local PostgreSQL credentials (docker compose postgres service)
LOCAL_POSTGRES_DB=exam_middleware
LOCAL_POSTGRES_USER=exam_user
LOCAL_POSTGRES_PASSWORD=exam_password

# Middleware database URL inside Docker network
DATABASE_URL=postgresql+asyncpg://exam_user:exam_password@postgres:5432/exam_middleware
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=exam_user
POSTGRES_DB=exam_middleware

# ML service URL inside Docker network
HF_SPACE_URL=http://ml-service:7860

# App config
DEBUG=false
SECRET_KEY=replace-this-local-secret
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]
UPLOAD_DIR=/app/uploads

# Moodle stays external
MOODLE_BASE_URL=https://your-moodle-domain.example
MOODLE_SERVICE=moodle_mobile_app
MOODLE_ADMIN_TOKEN=

# Local SMTP sink (MailHog)
SMTP_ENABLED=true
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@local.exam-middleware
SMTP_FROM_NAME=Exam Middleware Local
