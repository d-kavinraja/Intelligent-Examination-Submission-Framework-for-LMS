FROM pytorch/pytorch:2.1.1-cuda12.1-cudnn8-runtime

WORKDIR /app

# System dependencies for cv2/pdf/image processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxcb1 \
    libx11-6 \
    libxext6 \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (torch/torchvision already in base image)
COPY hf_space/requirements.gpu.txt .
RUN pip install --no-cache-dir -r requirements.gpu.txt

# Copy app and baked-in models
COPY hf_space/app.py .
COPY exam_middleware/models/ ./models/

ENV PORT=7860 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:7860/health').read()" || exit 1

CMD ["python", "app.py"]
