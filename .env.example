# Database - Neon PostgreSQL
DATABASE_URL=your_string

# Application Settings
DEBUG=true
SECRET_KEY=8f3a9c7e4b2d9e1a6c7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Moodle LMS Configuration
MOODLE_BASE_URL=https://saveetha-exam-middleware.moodlecloud.com
MOODLE_WS_ENDPOINT=/webservice/rest/server.php
MOODLE_UPLOAD_ENDPOINT=/webservice/upload.php
MOODLE_TOKEN_ENDPOINT=/login/token.php
