# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
